      "source": [
        "fig, axes = plt.subplots(1, 2, figsize=(14, 4.5))\nepochs_range = np.arange(1, len(history['loss_D']) + 1)\n\naxes[0].plot(epochs_range, history['loss_D'], marker='o', color='#2563eb', lw=2, label='Pérdida Discriminador (Loss_D)')\naxes[0].plot(epochs_range, history['loss_G'], marker='s', color='#dc2626', lw=2, label='Pérdida Generador (Loss_G)')\naxes[0].set_title('(A) Evolución de Pérdidas Adversariales DCGAN', fontsize=10.5, fontweight='bold')\naxes[0].set_xlabel('Época')\naxes[0].set_ylabel('Binary Cross-Entropy Loss')\naxes[0].grid(True, linestyle='--', alpha=0.5)\naxes[0].legend()\n\naxes[1].plot(epochs_range, history['D_x'], marker='o', color='#0d9488', lw=2, label='D(x) - Rostros Reales')\naxes[1].plot(epochs_range, history['D_G_z2'], marker='^', color='#d97706', lw=2, label='D(G(z)) - Rostros Sintéticos')\naxes[1].axhline(0.5, color='#334155', linestyle=':', label='Equilibrio Teórico de Nash (0.50)')\naxes[1].set_title('(B) Probabilidades Promedio del Discriminador', fontsize=10.5, fontweight='bold')\naxes[1].set_xlabel('Época')\naxes[1].set_ylabel('Probabilidad Estimada D(.)')\naxes[1].grid(True, linestyle='--', alpha=0.5)\naxes[1].legend()\nplt.tight_layout()\nplt.show()\n\n# Progresión visual de rostros sintéticos por etapa de entrenamiento\nfig, axes = plt.subplots(1, len(snapshots), figsize=(4.8 * len(snapshots), 4.8))\nif len(snapshots) == 1:\n    axes = [axes]\nfor ax, (etapa, tensor_imgs) in zip(axes, snapshots.items()):\n    grid = np.transpose(vutils.make_grid(tensor_imgs[:16], nrow=4, padding=2, normalize=True).numpy(), (1, 2, 0))\n    ax.imshow(grid)\n    ax.set_title(f'Muestras Sintéticas G(z) - {etapa}', fontsize=10, fontweight='bold')\n    ax.axis('off')\nplt.tight_layout()\nplt.show()"
      ]
